# Ferabot — variáveis de ambiente
# Copie este arquivo para .env e preencha com suas chaves reais
# NUNCA commite o arquivo .env no git

# Meta Ads (Facebook/Instagram Ads)
# Obter em: business.facebook.com → Configurações → Meta Business → Tokens
META_ACCESS_TOKEN=EAAxxxx_seu_token_aqui
META_AD_ACCOUNT_ID=act_000000000000000
META_APP_ID=000000000000000
META_APP_SECRET=sua_app_secret_aqui

# Netlify (deploy de landing pages)
# Obter em: app.netlify.com → User Settings → Applications → Personal access tokens
NETLIFY_TOKEN=seu_netlify_token_aqui

# Zernio (automação de DMs no Instagram)
# Obter em: zernio.com → Configurações → API Keys
ZERNIO_API_KEY=sua_chave_zernio_aqui
ZERNIO_PROFILE_ID=id_do_perfil_instagram_no_zernio
