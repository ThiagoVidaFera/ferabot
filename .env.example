# Chaves de API do Ferabot — TODAS são SUAS (das suas próprias contas).
# Copie este arquivo para .env  OU  rode: python SetupFera/setup_chaves.py
# Guia passo a passo de cada chave: API_SETUP.md
# NENHUMA é obrigatória — sem chave o FeraBot entrega a peça e ensina o caminho manual.
# NUNCA commite o arquivo .env no git (já está no .gitignore).

# Imagens com IA (grátis — aistudio.google.com)
GEMINI_API_KEY=

# Publicar páginas com um comando (conta grátis — app.netlify.com)
NETLIFY_AUTH_TOKEN=

# Subir campanhas no Meta Ads (sua conta de anúncios)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Subir vídeos no SEU canal do YouTube (projeto Google Cloud seu)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Comentário → DM no Instagram (app Meta seu, captação de leads)
IG_USER_ID=
IG_ACCESS_TOKEN=
